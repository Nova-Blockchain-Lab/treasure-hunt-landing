# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# Leave empty to disable GA4 tracking
NEXT_PUBLIC_GA_ID=

# PostHog Analytics & A/B Testing
# Get your key from https://us.posthog.com/settings/project-api-key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# --- Booking backend (Cal.com) -------------------------------------------
# Set BOTH of these and the booking flow switches from Microsoft Bookings to
# Cal.com: ~0.2 s availability instead of ~15 s, and no 6-digit email
# verification code (Microsoft enforces that server-side; Cal.com does not).
# No API key is needed while the event type is public.
#   CALCOM_USERNAME     your cal.com handle, e.g. "novablockchainlab"
#   CALCOM_EVENT_SLUG   the event type slug, e.g. "30min"
CALCOM_USERNAME=
CALCOM_EVENT_SLUG=
# Optional: length of that event type in minutes (default 30), shown in the widget.
CALCOM_EVENT_MINUTES=30
# Optional: meeting location label shown in the widget (default "Cal Video").
CALCOM_LOCATION=

# Optional: only needed if the event type is NOT public.
CALCOM_API_KEY=
